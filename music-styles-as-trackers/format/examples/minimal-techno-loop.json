        "params": { "wave": "saw", "unison": 3, "unisonDetune": 12, "unisonSpread": 0.6 },
        "filter": { "type": "lowpass", "cutoff": 0.5, "resonance": 0.4, "envAmount": 0.35, "env": { "decay": 0.15, "sustain": 0 } },
