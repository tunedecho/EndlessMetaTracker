{
  "format": "tracker-song/0.1",
  "meta": {
    "title": "Minimal Techno Loop",
    "style": "hypnotic-techno",
    "notes": "A hand-written loop showing the tracker vocabulary: four drum voices, a bass, a stab with a table, chains with transposes, and a song grid where layers enter row by row."
